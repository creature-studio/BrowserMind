{
  "id": "grok",
  "name": "Grok Web",
  "version": "1.0.0",
  "description": "Drives grok.com (and the x.com/i/grok panel). Declarative plugin: manifest + selectors, no code.",
  "homepage": "https://grok.com",
  "author": "BrowserMind",
  "accent": "#111827",
  "capabilities": ["chat", "file_upload", "image_input", "search", "stop", "new_chat"],
  "matchPatterns": ["https://grok.com/*", "https://x.com/i/grok*"],
  "states": {
    "ready": "ready",
    "busy": "generating",
    "blocked": "login-required",
    "waiting": "loading"
  },
  "selectors": {
    "input": [
      "textarea[aria-label=\"Ask Grok anything\"]",
      "#query-input",
      "textarea[placeholder*=\"want to know\"]",
      "div[contenteditable=\"true\"][role=\"textbox\"]"
    ],
    "sendButton": [
      "button[type=\"submit\"]",
      "button.submit-button",
      "button[aria-label=\"Submit\"]"
    ],
    "submitKeys": ["Enter"],
    "response": [
      ".message-bubble.assistant .response-content-markdown",
      ".response-content-markdown",
      "[data-testid=\"message-bubble\"] .markdown"
    ],
    "streaming": [
      "button.stop-button:not([hidden])",
      "button[aria-label=\"Stop model response\"]:not([hidden])",
      ".response-streaming"
    ],
    "busy": ["button[aria-label=\"Stop model response\"]:not([hidden])"],
    "ready": ["#query-input", "textarea[aria-label=\"Ask Grok anything\"]"],
    "blocked": ["#login-wall:not([hidden])", "[data-testid=\"sign-in-required\"]"],
    "fileInput": ["input.file-input", "input[type=\"file\"]"],
    "attachButton": ["button[aria-label*=\"Attach\"]", "button[aria-label*=\"upload\"]"],
    "newChat": ["button.new-chat-button", "a[href=\"/chat\"]"],
    "stopButton": ["button.stop-button:not([hidden])", "button[aria-label=\"Stop model response\"]:not([hidden])"],
    "userMessage": [".message-bubble.user .query-text", ".query-text"],
    "actions": [
      {
        "id": "toggle-deepsearch",
        "label": "DeepSearch",
        "kind": "toggle",
        "selector": "button[aria-label*=\"DeepSearch\"]",
        "stateSelector": "button[aria-label*=\"DeepSearch\"]"
      }
    ],
    "quietMs": 700,
    "pollMs": 120,
    "stepTimeoutMs": 10000,
    "transcriptLimit": 20
  }
}
